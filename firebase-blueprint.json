{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated teacher profile information and school affiliation.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID matching the document ID.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "Verified Google account email address.",
          "maxLength": 254
        },
        "displayName": {
          "type": "string",
          "description": "Teacher display name used on certificates and forum posts.",
          "minLength": 1,
          "maxLength": 120
        },
        "designation": {
          "type": "string",
          "description": "Teacher role or designation at their school.",
          "maxLength": 120
        },
        "schoolName": {
          "type": "string",
          "description": "Teacher school or institution name.",
          "maxLength": 160
        },
        "photoUrl": {
          "type": "string",
          "description": "Optional profile avatar URL.",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when the profile was created."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the last profile update."
        }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "designation",
        "schoolName",
        "createdAt",
        "updatedAt"
      ]
    },
    "LearnerProgressDoc": {
      "title": "LearnerProgressDoc",
      "description": "Authenticated teacher LMS training progress, quiz results, lesson notes, and study time.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "Owner Firebase Auth UID.",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "completedLessonIds": {
          "type": "array",
          "description": "IDs of completed course lessons (max 50)."
        },
        "readMaterialIds": {
          "type": "array",
          "description": "IDs of read or downloaded lesson materials (max 50)."
        },
        "registeredSessionIds": {
          "type": "array",
          "description": "IDs of registered live training sessions (max 50)."
        },
        "quizResults": {
          "type": "object",
          "description": "Best quiz outcomes keyed by course ID."
        },
        "unlockedAchievementDates": {
          "type": "object",
          "description": "Unlocked digital badge dates keyed by achievement ID."
        },
        "lessonNotes": {
          "type": "object",
          "description": "Personal lesson notebook entries and optional voice reflection metadata keyed by lesson ID."
        },
        "studySecondsByDate": {
          "type": "object",
          "description": "Recorded study seconds keyed by YYYY-MM-DD."
        },
        "activityCountByDate": {
          "type": "object",
          "description": "Recorded learning activities count keyed by YYYY-MM-DD."
        },
        "helpfulDiscussionIds": {
          "type": "array",
          "description": "IDs of discussion posts marked helpful (max 200)."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp when progress tracking started."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of the latest progress sync."
        }
      },
      "required": [
        "userId",
        "completedLessonIds",
        "readMaterialIds",
        "registeredSessionIds",
        "quizResults",
        "unlockedAchievementDates",
        "lessonNotes",
        "studySecondsByDate",
        "activityCountByDate",
        "helpfulDiscussionIds",
        "createdAt",
        "updatedAt"
      ]
    },
    "CustomCourseDoc": {
      "title": "CustomCourseDoc",
      "description": "Dynamic training course uploaded or created from the Admin Panel.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "subtitle": {
          "type": "string",
          "maxLength": 240
        },
        "category": {
          "type": "string",
          "enum": ["tpack-tech", "pedagogy-eval", "research-leadership"]
        },
        "categoryLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "levelLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "cpdHoursLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "totalDurationLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "instructor": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "instructorRole": {
          "type": "string",
          "maxLength": 160
        },
        "imagePath": {
          "type": "string",
          "maxLength": 100000
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1500
        },
        "lessons": {
          "type": "array",
          "description": "Course lessons with embedded chapters and lesson material (max 25)."
        },
        "quiz": {
          "type": "array",
          "description": "Course evaluation quiz questions (max 30)."
        },
        "pathwayConfig": {
          "type": "object",
          "description": "Optional custom 5-step certification pathway configuration."
        },
        "orderIndex": {
          "type": "number",
          "description": "Optional display order index for course sequencing."
        },
        "published": {
          "type": "boolean"
        },
        "createdByUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "title",
        "subtitle",
        "category",
        "categoryLabel",
        "levelLabel",
        "cpdHoursLabel",
        "totalDurationLabel",
        "instructor",
        "instructorRole",
        "imagePath",
        "description",
        "lessons",
        "quiz",
        "published",
        "createdByUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "UploadedMaterialDoc": {
      "title": "UploadedMaterialDoc",
      "description": "Standalone training material or lesson handout uploaded via the Admin Panel.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "courseId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "courseTitle": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "category": {
          "type": "string",
          "enum": ["tpack-tech", "pedagogy-eval", "research-leadership"]
        },
        "categoryLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "formatLabel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "readTime": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "keyPoints": {
          "type": "array"
        },
        "actionChecklist": {
          "type": "array"
        },
        "classroomActivity": {
          "type": "object"
        },
        "attachmentName": {
          "type": "string",
          "maxLength": 180
        },
        "attachmentContent": {
          "type": "string",
          "maxLength": 50000
        },
        "attachmentMimeType": {
          "type": "string",
          "maxLength": 100
        },
        "videoSourceType": {
          "type": "string",
          "enum": ["none", "link", "upload"]
        },
        "videoUrl": {
          "type": "string",
          "maxLength": 1000
        },
        "videoFileName": {
          "type": "string",
          "maxLength": 180
        },
        "videoFileSizeLabel": {
          "type": "string",
          "maxLength": 40
        },
        "videoMimeType": {
          "type": "string",
          "maxLength": 100
        },
        "published": {
          "type": "boolean"
        },
        "createdByUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "id",
        "courseId",
        "courseTitle",
        "category",
        "categoryLabel",
        "title",
        "formatLabel",
        "readTime",
        "summary",
        "keyPoints",
        "actionChecklist",
        "classroomActivity",
        "attachmentName",
        "attachmentContent",
        "attachmentMimeType",
        "published",
        "createdByUid",
        "createdAt",
        "updatedAt"
      ]
    },
    "ModuleLayoutDoc": {
      "title": "ModuleLayoutDoc",
      "description": "Global display order and hidden visibility list for all training modules.",
      "type": "object",
      "properties": {
        "orderedIds": {
          "type": "array",
          "description": "Ordered list of course IDs (max 150)."
        },
        "hiddenCourseIds": {
          "type": "array",
          "description": "List of hidden course IDs (max 150)."
        },
        "updatedByUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "orderedIds",
        "hiddenCourseIds",
        "updatedByUid",
        "updatedAt"
      ]
    },
    "AccessControlDoc": {
      "title": "AccessControlDoc",
      "description": "Super Admin platform-wide trial, annual pro pricing, and access control policy.",
      "type": "object",
      "properties": {
        "freeTrialDays": { "type": "number" },
        "freeTrialMaxModules": { "type": "number" },
        "freeTrialAllowVideos": { "type": "boolean" },
        "freeTrialAllowMaterialsDownload": { "type": "boolean" },
        "freeTrialAllowQuiz": { "type": "boolean" },
        "freeTrialAllowCertificate": { "type": "boolean" },
        "annualPriceBdt": { "type": "number" },
        "annualDurationDays": { "type": "number" },
        "paymentInstructions": { "type": "string", "maxLength": 1000 },
        "maintenanceMode": { "type": "boolean" },
        "updatedByUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "freeTrialDays",
        "freeTrialMaxModules",
        "freeTrialAllowVideos",
        "freeTrialAllowMaterialsDownload",
        "freeTrialAllowQuiz",
        "freeTrialAllowCertificate",
        "annualPriceBdt",
        "annualDurationDays",
        "paymentInstructions",
        "maintenanceMode",
        "updatedByUid",
        "updatedAt"
      ]
    },
    "UserAccessDoc": {
      "title": "UserAccessDoc",
      "description": "Server-validated user subscription tier (7-day free trial or 1-year annual pro) controlled by Super Admin.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "planTier": { "type": "string", "enum": ["free_trial", "annual_pro", "suspended"] },
        "trialStartedAtMs": { "type": "number" },
        "trialEndsAtMs": { "type": "number" },
        "proActivatedAtMs": { "type": "number" },
        "proExpiresAtMs": { "type": "number" },
        "allowFullOverride": { "type": "boolean" },
        "customNote": { "type": "string", "maxLength": 500 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "planTier",
        "trialStartedAtMs",
        "trialEndsAtMs",
        "proActivatedAtMs",
        "proExpiresAtMs",
        "allowFullOverride",
        "customNote",
        "createdAt",
        "updatedAt"
      ]
    },
    "PaymentRequestDoc": {
      "title": "PaymentRequestDoc",
      "description": "Teacher payment verification request for ৳1,000 1-year full access.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userEmail": { "type": "string", "format": "email", "maxLength": 254 },
        "userName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "method": { "type": "string", "enum": ["bKash", "Nagad", "Rocket", "Bank"] },
        "senderPhone": { "type": "string", "minLength": 6, "maxLength": 30 },
        "transactionId": { "type": "string", "minLength": 3, "maxLength": 80 },
        "amountBdt": { "type": "number" },
        "note": { "type": "string", "maxLength": 400 },
        "status": { "type": "string", "enum": ["pending", "approved", "rejected"] },
        "reviewedByUid": { "type": "string", "maxLength": 128 },
        "reviewNote": { "type": "string", "maxLength": 400 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "id",
        "userId",
        "userEmail",
        "userName",
        "method",
        "senderPhone",
        "transactionId",
        "amountBdt",
        "note",
        "status",
        "reviewedByUid",
        "reviewNote",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminRoleDoc": {
      "title": "AdminRoleDoc",
      "description": "Delegated training module manager record controlled solely by Super Admin.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "format": "email", "maxLength": 254 },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "role": { "type": "string", "enum": ["module_manager"] },
        "grantedByUid": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "uid",
        "email",
        "displayName",
        "role",
        "grantedByUid",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Private teacher account profile document storing PII strictly accessible only by the authenticated owner."
    },
    "/users/{userId}/progress/{progressId}": {
      "schema": {
        "$ref": "#/entities/LearnerProgressDoc"
      },
      "description": "Teacher LMS learning progress subcollection gated by parent UserProfile existence and strict owner UID checks."
    },
    "/courses/{courseId}": {
      "schema": {
        "$ref": "#/entities/CustomCourseDoc"
      },
      "description": "Dynamic training courses or built-in overrides created or edited by Super Admin or delegated module managers."
    },
    "/materials/{materialId}": {
      "schema": {
        "$ref": "#/entities/UploadedMaterialDoc"
      },
      "description": "Standalone training materials, video links, and uploaded handouts managed by Super Admin or delegated module managers."
    },
    "/siteConfig/{configId}": {
      "schema": {
        "$ref": "#/entities/ModuleLayoutDoc"
      },
      "description": "Global platform configuration (moduleLayout and accessControl) managed by Super Admin / Module Managers."
    },
    "/userAccess/{userId}": {
      "schema": {
        "$ref": "#/entities/UserAccessDoc"
      },
      "description": "Teacher subscription and 7-day trial entitlement record; self-creation restricted to free_trial, updates restricted to Super Admin."
    },
    "/paymentRequests/{requestId}": {
      "schema": {
        "$ref": "#/entities/PaymentRequestDoc"
      },
      "description": "Subscription upgrade verification requests; readable by owner and Super Admin, approval/rejection strictly by Super Admin."
    },
    "/admins/{adminId}": {
      "schema": {
        "$ref": "#/entities/AdminRoleDoc"
      },
      "description": "Delegated module manager records provisioned and revoked strictly by Super Admin."
    }
  }
}
