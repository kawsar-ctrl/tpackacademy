rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Primitive Helpers
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerifiedUser() && request.auth.uid == userId;
    }

    function isBootstrappedAdminEmail() {
      return isVerifiedUser() && request.auth.token.email == 'aayat6666@gmail.com';
    }

    function isSuperAdmin() {
      return isBootstrappedAdminEmail();
    }

    function isModuleManager() {
      return isSuperAdmin()
        || (isVerifiedUser() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    // 3. Entity Validation Blueprints
    function isValidStringList(listVal, maxItems) {
      return listVal is list
        && listVal.size() <= maxItems
        && (listVal.size() == 0 || (listVal[0] is string && listVal[0].size() <= 240));
    }

    function isValidMapList(listVal, maxItems) {
      return listVal is list
        && listVal.size() <= maxItems
        && (listVal.size() == 0 || listVal[0] is map);
    }

    function isValidCategory(cat) {
      return cat is string
        && (cat == 'tpack-tech' || cat == 'pedagogy-eval' || cat == 'research-leadership');
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'designation',
          'schoolName',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'designation',
          'schoolName',
          'photoUrl',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid.size() >= 1
        && data.uid.size() <= 128
        && data.uid == userId
        && data.uid == request.auth.uid
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && data.designation is string
        && data.designation.size() <= 120
        && data.schoolName is string
        && data.schoolName.size() <= 160
        && (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLearnerProgress(data, userId) {
      return data.keys().hasAll([
          'userId',
          'completedLessonIds',
          'readMaterialIds',
          'registeredSessionIds',
          'quizResults',
          'unlockedAchievementDates',
          'lessonNotes',
          'studySecondsByDate',
          'activityCountByDate',
          'helpfulDiscussionIds',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'userId',
          'completedLessonIds',
          'readMaterialIds',
          'registeredSessionIds',
          'quizResults',
          'unlockedAchievementDates',
          'lessonNotes',
          'studySecondsByDate',
          'activityCountByDate',
          'helpfulDiscussionIds',
          'createdAt',
          'updatedAt'
        ])
        && data.userId is string
        && data.userId.size() >= 1
        && data.userId.size() <= 128
        && data.userId == userId
        && data.userId == request.auth.uid
        && isValidStringList(data.completedLessonIds, 50)
        && isValidStringList(data.readMaterialIds, 50)
        && isValidStringList(data.registeredSessionIds, 50)
        && data.quizResults is map
        && data.quizResults.size() <= 40
        && data.unlockedAchievementDates is map
        && data.unlockedAchievementDates.size() <= 40
        && data.lessonNotes is map
        && data.lessonNotes.size() <= 80
        && data.studySecondsByDate is map
        && data.studySecondsByDate.size() <= 366
        && data.activityCountByDate is map
        && data.activityCountByDate.size() <= 366
        && isValidStringList(data.helpfulDiscussionIds, 200)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCustomCourse(data, courseId) {
      return data.keys().hasAll([
          'id',
          'title',
          'subtitle',
          'category',
          'categoryLabel',
          'levelLabel',
          'cpdHoursLabel',
          'totalDurationLabel',
          'instructor',
          'instructorRole',
          'imagePath',
          'description',
          'lessons',
          'quiz',
          'published',
          'createdByUid',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'title',
          'subtitle',
          'category',
          'categoryLabel',
          'levelLabel',
          'cpdHoursLabel',
          'totalDurationLabel',
          'instructor',
          'instructorRole',
          'imagePath',
          'description',
          'lessons',
          'quiz',
          'pathwayConfig',
          'orderIndex',
          'published',
          'createdByUid',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string
        && data.id == courseId
        && isValidId(data.id)
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 160
        && data.subtitle is string
        && data.subtitle.size() <= 240
        && isValidCategory(data.category)
        && data.categoryLabel is string
        && data.categoryLabel.size() >= 1
        && data.categoryLabel.size() <= 80
        && data.levelLabel is string
        && data.levelLabel.size() >= 1
        && data.levelLabel.size() <= 80
        && data.cpdHoursLabel is string
        && data.cpdHoursLabel.size() >= 1
        && data.cpdHoursLabel.size() <= 60
        && data.totalDurationLabel is string
        && data.totalDurationLabel.size() >= 1
        && data.totalDurationLabel.size() <= 80
        && data.instructor is string
        && data.instructor.size() >= 1
        && data.instructor.size() <= 120
        && data.instructorRole is string
        && data.instructorRole.size() <= 160
        && data.imagePath is string
        && data.imagePath.size() <= 100000
        && data.description is string
        && data.description.size() >= 1
        && data.description.size() <= 1500
        && isValidMapList(data.lessons, 25)
        && isValidMapList(data.quiz, 30)
        && (!('pathwayConfig' in data) || data.pathwayConfig is map)
        && (!('orderIndex' in data) || data.orderIndex is number)
        && data.published is bool
        && data.createdByUid is string
        && data.createdByUid.size() >= 1
        && data.createdByUid.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidModuleLayout(data) {
      return data.keys().hasAll([
          'orderedIds',
          'hiddenCourseIds',
          'updatedByUid',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'orderedIds',
          'hiddenCourseIds',
          'updatedByUid',
          'updatedAt'
        ])
        && isValidStringList(data.orderedIds, 150)
        && isValidStringList(data.hiddenCourseIds, 150)
        && data.updatedByUid is string
        && data.updatedByUid.size() >= 1
        && data.updatedByUid.size() <= 128
        && data.updatedByUid == request.auth.uid
        && data.updatedAt is timestamp;
    }

    function isValidAccessControl(data) {
      return data.keys().hasAll([
          'freeTrialDays',
          'freeTrialMaxModules',
          'freeTrialAllowVideos',
          'freeTrialAllowMaterialsDownload',
          'freeTrialAllowQuiz',
          'freeTrialAllowCertificate',
          'annualPriceBdt',
          'annualDurationDays',
          'paymentInstructions',
          'maintenanceMode',
          'updatedByUid',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'freeTrialDays',
          'freeTrialMaxModules',
          'freeTrialAllowVideos',
          'freeTrialAllowMaterialsDownload',
          'freeTrialAllowQuiz',
          'freeTrialAllowCertificate',
          'annualPriceBdt',
          'annualDurationDays',
          'paymentInstructions',
          'maintenanceMode',
          'updatedByUid',
          'updatedAt'
        ])
        && data.freeTrialDays is number
        && data.freeTrialDays >= 1
        && data.freeTrialDays <= 60
        && data.freeTrialMaxModules is number
        && data.freeTrialMaxModules >= 1
        && data.freeTrialMaxModules <= 50
        && data.freeTrialAllowVideos is bool
        && data.freeTrialAllowMaterialsDownload is bool
        && data.freeTrialAllowQuiz is bool
        && data.freeTrialAllowCertificate is bool
        && data.annualPriceBdt is number
        && data.annualPriceBdt >= 0
        && data.annualPriceBdt <= 100000
        && data.annualDurationDays is number
        && data.annualDurationDays >= 30
        && data.annualDurationDays <= 1095
        && data.paymentInstructions is string
        && data.paymentInstructions.size() <= 1000
        && data.maintenanceMode is bool
        && data.updatedByUid is string
        && data.updatedByUid.size() >= 1
        && data.updatedByUid.size() <= 128
        && data.updatedByUid == request.auth.uid
        && data.updatedAt is timestamp;
    }

    function isValidUploadedMaterial(data, materialId) {
      return data.keys().hasAll([
          'id',
          'courseId',
          'courseTitle',
          'category',
          'categoryLabel',
          'title',
          'formatLabel',
          'readTime',
          'summary',
          'keyPoints',
          'actionChecklist',
          'classroomActivity',
          'attachmentName',
          'attachmentContent',
          'attachmentMimeType',
          'published',
          'createdByUid',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'courseId',
          'courseTitle',
          'category',
          'categoryLabel',
          'title',
          'formatLabel',
          'readTime',
          'summary',
          'keyPoints',
          'actionChecklist',
          'classroomActivity',
          'attachmentName',
          'attachmentContent',
          'attachmentMimeType',
          'videoSourceType',
          'videoUrl',
          'videoFileName',
          'videoFileSizeLabel',
          'videoMimeType',
          'published',
          'createdByUid',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string
        && data.id == materialId
        && isValidId(data.id)
        && isValidId(data.courseId)
        && data.courseTitle is string
        && data.courseTitle.size() >= 1
        && data.courseTitle.size() <= 160
        && isValidCategory(data.category)
        && data.categoryLabel is string
        && data.categoryLabel.size() >= 1
        && data.categoryLabel.size() <= 80
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 160
        && data.formatLabel is string
        && data.formatLabel.size() >= 1
        && data.formatLabel.size() <= 60
        && data.readTime is string
        && data.readTime.size() >= 1
        && data.readTime.size() <= 40
        && data.summary is string
        && data.summary.size() >= 1
        && data.summary.size() <= 2000
        && isValidStringList(data.keyPoints, 20)
        && isValidStringList(data.actionChecklist, 20)
        && data.classroomActivity is map
        && data.classroomActivity.keys().hasAll(['gradeLevel', 'duration', 'objective'])
        && data.classroomActivity.keys().hasOnly(['gradeLevel', 'duration', 'objective'])
        && data.classroomActivity.gradeLevel is string
        && data.classroomActivity.gradeLevel.size() <= 120
        && data.classroomActivity.duration is string
        && data.classroomActivity.duration.size() <= 120
        && data.classroomActivity.objective is string
        && data.classroomActivity.objective.size() <= 400
        && data.attachmentName is string
        && data.attachmentName.size() <= 180
        && data.attachmentContent is string
        && data.attachmentContent.size() <= 50000
        && data.attachmentMimeType is string
        && data.attachmentMimeType.size() <= 100
        && (!('videoSourceType' in data) || (data.videoSourceType is string && (data.videoSourceType == 'none' || data.videoSourceType == 'link' || data.videoSourceType == 'upload')))
        && (!('videoUrl' in data) || (data.videoUrl is string && data.videoUrl.size() <= 1000))
        && (!('videoFileName' in data) || (data.videoFileName is string && data.videoFileName.size() <= 180))
        && (!('videoFileSizeLabel' in data) || (data.videoFileSizeLabel is string && data.videoFileSizeLabel.size() <= 40))
        && (!('videoMimeType' in data) || (data.videoMimeType is string && data.videoMimeType.size() <= 100))
        && data.published is bool
        && data.createdByUid is string
        && data.createdByUid.size() >= 1
        && data.createdByUid.size() <= 128
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidUserAccess(data, userId) {
      return data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'planTier',
          'trialStartedAtMs',
          'trialEndsAtMs',
          'proActivatedAtMs',
          'proExpiresAtMs',
          'allowFullOverride',
          'customNote',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'planTier',
          'trialStartedAtMs',
          'trialEndsAtMs',
          'proActivatedAtMs',
          'proExpiresAtMs',
          'allowFullOverride',
          'customNote',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == userId
        && isValidId(data.uid)
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && data.planTier is string
        && (data.planTier == 'free_trial' || data.planTier == 'annual_pro' || data.planTier == 'suspended')
        && data.trialStartedAtMs is number
        && data.trialStartedAtMs >= 0
        && data.trialEndsAtMs is number
        && data.trialEndsAtMs >= 0
        && data.proActivatedAtMs is number
        && data.proActivatedAtMs >= 0
        && data.proExpiresAtMs is number
        && data.proExpiresAtMs >= 0
        && data.allowFullOverride is bool
        && data.customNote is string
        && data.customNote.size() <= 500
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPaymentRequest(data, requestId) {
      return data.keys().hasAll([
          'id',
          'userId',
          'userEmail',
          'userName',
          'method',
          'senderPhone',
          'transactionId',
          'amountBdt',
          'note',
          'status',
          'reviewedByUid',
          'reviewNote',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'userId',
          'userEmail',
          'userName',
          'method',
          'senderPhone',
          'transactionId',
          'amountBdt',
          'note',
          'status',
          'reviewedByUid',
          'reviewNote',
          'createdAt',
          'updatedAt'
        ])
        && data.id is string
        && data.id == requestId
        && isValidId(data.id)
        && data.userId is string
        && isValidId(data.userId)
        && data.userEmail is string
        && data.userEmail.size() >= 3
        && data.userEmail.size() <= 254
        && data.userName is string
        && data.userName.size() >= 1
        && data.userName.size() <= 120
        && data.method is string
        && (data.method == 'bKash' || data.method == 'Nagad' || data.method == 'Rocket' || data.method == 'Bank')
        && data.senderPhone is string
        && data.senderPhone.size() >= 6
        && data.senderPhone.size() <= 30
        && data.transactionId is string
        && data.transactionId.size() >= 3
        && data.transactionId.size() <= 80
        && data.amountBdt is number
        && data.amountBdt >= 1
        && data.amountBdt <= 100000
        && data.note is string
        && data.note.size() <= 400
        && data.status is string
        && (data.status == 'pending' || data.status == 'approved' || data.status == 'rejected')
        && data.reviewedByUid is string
        && data.reviewedByUid.size() <= 128
        && data.reviewNote is string
        && data.reviewNote.size() <= 400
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminRole(data, adminId) {
      return data.keys().hasAll([
          'uid',
          'email',
          'displayName',
          'role',
          'grantedByUid',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'email',
          'displayName',
          'role',
          'grantedByUid',
          'createdAt',
          'updatedAt'
        ])
        && data.uid is string
        && data.uid == adminId
        && isValidId(data.uid)
        && data.email is string
        && data.email.size() >= 3
        && data.email.size() <= 254
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 120
        && data.role == 'module_manager'
        && data.grantedByUid is string
        && data.grantedByUid.size() >= 1
        && data.grantedByUid.size() <= 128
        && data.grantedByUid == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    // 4. Collection Rules
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (isOwner(adminId) || isSuperAdmin());
      allow list: if isBootstrappedAdminEmail();

      allow create: if isValidId(adminId)
        && isSuperAdmin()
        && isValidAdminRole(incoming(), adminId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(adminId)
        && isSuperAdmin()
        && isValidAdminRole(incoming(), adminId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;

      allow delete: if isValidId(adminId) && isSuperAdmin();
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(userId)
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'designation',
            'schoolName',
            'photoUrl',
            'updatedAt'
          ])
        );

      allow delete: if false;

      // Master-Gated Progress Subcollection
      match /progress/{progressId} {
        allow get: if isValidId(userId)
          && isValidId(progressId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId));
        allow list: if false;

        allow create: if isValidId(userId)
          && isValidId(progressId)
          && progressId == 'main'
          && isOwner(userId)
          && isValidLearnerProgress(incoming(), userId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && (
            exists(/databases/$(database)/documents/users/$(userId))
            || existsAfter(/databases/$(database)/documents/users/$(userId))
          );

        allow update: if isValidId(userId)
          && isValidId(progressId)
          && progressId == 'main'
          && isOwner(userId)
          && isValidLearnerProgress(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(userId))
          && (
            incoming().diff(existing()).affectedKeys().hasOnly([
              'completedLessonIds',
              'readMaterialIds',
              'registeredSessionIds',
              'quizResults',
              'unlockedAchievementDates',
              'lessonNotes',
              'studySecondsByDate',
              'activityCountByDate',
              'helpfulDiscussionIds',
              'updatedAt'
            ])
          );

        allow delete: if false;
      }
    }

    match /userAccess/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isSuperAdmin());
      allow list: if isBootstrappedAdminEmail();

      allow create: if isValidId(userId)
        && isValidUserAccess(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isSuperAdmin()
          || (
            isOwner(userId)
            && incoming().email == request.auth.token.email
            && incoming().planTier == 'free_trial'
            && incoming().proActivatedAtMs == 0
            && incoming().proExpiresAtMs == 0
            && incoming().allowFullOverride == false
            && incoming().customNote == ''
            && incoming().trialStartedAtMs <= request.time.toMillis() + 60000
            && incoming().trialEndsAtMs <= request.time.toMillis() + 1296000000
          )
        );

      allow update: if isValidId(userId)
        && isSuperAdmin()
        && isValidUserAccess(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'planTier',
          'trialStartedAtMs',
          'trialEndsAtMs',
          'proActivatedAtMs',
          'proExpiresAtMs',
          'allowFullOverride',
          'customNote',
          'updatedAt'
        ]);

      allow delete: if isValidId(userId) && isSuperAdmin();
    }

    match /paymentRequests/{requestId} {
      allow get: if isValidId(requestId)
        && (isSuperAdmin() || (isVerifiedUser() && existing().userId == request.auth.uid));

      allow list: if isBootstrappedAdminEmail()
        || (isVerifiedUser() && existing().userId == request.auth.uid);

      allow create: if isValidId(requestId)
        && isVerifiedUser()
        && isValidPaymentRequest(incoming(), requestId)
        && incoming().userId == request.auth.uid
        && incoming().userEmail == request.auth.token.email
        && incoming().status == 'pending'
        && incoming().reviewedByUid == ''
        && incoming().reviewNote == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(requestId)
        && isSuperAdmin()
        && isValidPaymentRequest(incoming(), requestId)
        && incoming().id == existing().id
        && incoming().userId == existing().userId
        && incoming().userEmail == existing().userEmail
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().reviewedByUid == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'status',
          'reviewedByUid',
          'reviewNote',
          'updatedAt'
        ]);

      allow delete: if isValidId(requestId) && isSuperAdmin();
    }

    match /courses/{courseId} {
      allow get: if isValidId(courseId) && (existing().published == true || isModuleManager());
      allow list: if existing().published == true || isBootstrappedAdminEmail();

      allow create: if isValidId(courseId)
        && isModuleManager()
        && isValidCustomCourse(incoming(), courseId)
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(courseId)
        && isModuleManager()
        && isValidCustomCourse(incoming(), courseId)
        && incoming().id == existing().id
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'title',
          'subtitle',
          'category',
          'categoryLabel',
          'levelLabel',
          'cpdHoursLabel',
          'totalDurationLabel',
          'instructor',
          'instructorRole',
          'imagePath',
          'description',
          'lessons',
          'quiz',
          'pathwayConfig',
          'orderIndex',
          'published',
          'updatedAt'
        ]);

      allow delete: if isValidId(courseId) && isModuleManager();
    }

    match /materials/{materialId} {
      allow get: if isValidId(materialId) && (existing().published == true || isModuleManager());
      allow list: if existing().published == true || isBootstrappedAdminEmail();

      allow create: if isValidId(materialId)
        && isModuleManager()
        && isValidUploadedMaterial(incoming(), materialId)
        && incoming().createdByUid == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isValidId(materialId)
        && isModuleManager()
        && isValidUploadedMaterial(incoming(), materialId)
        && incoming().id == existing().id
        && incoming().createdByUid == existing().createdByUid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'courseId',
          'courseTitle',
          'category',
          'categoryLabel',
          'title',
          'formatLabel',
          'readTime',
          'summary',
          'keyPoints',
          'actionChecklist',
          'classroomActivity',
          'attachmentName',
          'attachmentContent',
          'attachmentMimeType',
          'videoSourceType',
          'videoUrl',
          'videoFileName',
          'videoFileSizeLabel',
          'videoMimeType',
          'published',
          'updatedAt'
        ]);

      allow delete: if isValidId(materialId) && isModuleManager();
    }

    match /siteConfig/{configId} {
      allow get: if isValidId(configId) && (configId == 'moduleLayout' || configId == 'accessControl');
      allow list: if false;

      allow create: if isValidId(configId)
        && incoming().updatedAt == request.time
        && (
          (configId == 'moduleLayout' && isModuleManager() && isValidModuleLayout(incoming()))
          || (configId == 'accessControl' && isSuperAdmin() && isValidAccessControl(incoming()))
        );

      allow update: if isValidId(configId)
        && incoming().updatedAt == request.time
        && (
          (
            configId == 'moduleLayout'
            && isModuleManager()
            && isValidModuleLayout(incoming())
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'orderedIds',
              'hiddenCourseIds',
              'updatedByUid',
              'updatedAt'
            ])
          )
          || (
            configId == 'accessControl'
            && isSuperAdmin()
            && isValidAccessControl(incoming())
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'freeTrialDays',
              'freeTrialMaxModules',
              'freeTrialAllowVideos',
              'freeTrialAllowMaterialsDownload',
              'freeTrialAllowQuiz',
              'freeTrialAllowCertificate',
              'annualPriceBdt',
              'annualDurationDays',
              'paymentInstructions',
              'maintenanceMode',
              'updatedByUid',
              'updatedAt'
            ])
          )
        );

      allow delete: if isValidId(configId)
        && (
          (configId == 'moduleLayout' && isModuleManager())
          || (configId == 'accessControl' && isSuperAdmin())
        );
    }
  }
}
